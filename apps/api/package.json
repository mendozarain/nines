    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nines/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "better-auth": "^1.3.27",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.1.0",
